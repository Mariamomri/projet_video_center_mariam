<div class="mt-3">
    {% if app.user %}
        <a class="btn btn-outline-primary btn-sm"
          href="{{ path('like.video', {id: video.id}) }}"
          data-action="like"
          id="like-button-{{ video.id }}">

            <span class="like-icon">{{ app.user in video.likes ? '❤️' : '🤍' }}</span>
            <span class="like-count">{{ video.likes|length }} {{ 'like.text' | trans }}</span>
        </a>
    {% endif %}
</div>

<script>
    document.getElementById('like-button-{{ video.id }}')?.addEventListener('click', function (event) {
        event.preventDefault();
        const button = this;

        fetch(button.href)
            .then(response => response.json())
            .then(data => {
                button.querySelector('.like-count').textContent = data.nbLike + ' {{ 'like.text' | trans }}';
                button.querySelector('.like-icon').textContent = data.liked ? '❤️' : '🤍';
            });
    });
</script>