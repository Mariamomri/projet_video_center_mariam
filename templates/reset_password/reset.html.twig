{% extends 'base.html.twig' %}

{% block title %}{{ 'resetPassword.title' | trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6 mx-auto">
            <h1>{{ 'resetPassword.title' | trans }}</h1>

            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword) }}
                <button class="btn btn-primary">{{ 'resetPassword.submit' | trans }}</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}