{% extends 'base.html.twig' %}

{% block title %}{{ 'resetPassword.emailSentTitle' | trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6 mx-auto">
            <p>
                {{ 'resetPassword.emailSentText' | trans }} {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p>{{ 'resetPassword.checkSpam' | trans }} <a href="{{ path('app_forgot_password_request') }}">{{ 'resetPassword.tryAgain' | trans }}</a></p>
        </div>
    </div>
{% endblock %}