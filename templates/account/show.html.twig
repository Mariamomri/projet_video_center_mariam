{% extends 'base.html.twig' %}

{% block title 'Profile' %}

{% block body %}
    <div class="row">
        <div class="col-md-6 mx-auto text-center">
            <h1>{{ 'accountShow.profile'|trans }}</h1>
            <img style="max-width: 250px;" src={{ vich_uploader_asset(app.user, 'imageFile') }}>
            <br>
            <p>{{ app.user.email }}</p>
            <h2>{{ app.user.firstname ~ " " ~ app.user.lastname }}</h2>
            <p>{{ 'accountShow.Accountcreatedon'|trans }} {{ app.user.createdAt|date("d/m/Y") }}</p>
            <br>
            <p>
                <a class="btn btn-primary btn-sm" href={{ path('app_account_edit') }}>{{ 'accountShow.EditAccount'|trans }}</a>
            </p>
        </div>
    </div>

    <h2 class="text-center my-4">{{ 'accountShow.myVideos'|trans }}</h2>
    <div class="video-grid">
        {% for video in app.user.videos %}
            <div class="video-card>
                <a href="{{ path('app_video_show', {id: video.id}) }}">
                    <h5>{{ video.title|slice(0, 20) }}</h5>
                    <iframe width="300" height="200" src="{{ video.videoLink }}"></iframe>
                </a>
                <p>{{ video.descritpion|slice(0, 25) }}</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}