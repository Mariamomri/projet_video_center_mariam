{% extends 'base.html.twig' %}

{% block title 'Profile' %}

{% block body %}
    <div class="profile-card">
        <img class="profile-avatar" src="{{ asset(vich_uploader_asset(app.user, 'imageFile')) }}">
        <p class="text-muted-custom">{{ app.user.email }}</p>
        <h2>{{ app.user.firstname ~ " " ~ app.user.lastname }}</h2>
        <p class="text-muted-custom">{{ 'accountShow.Accountcreatedon'|trans }} {{ app.user.createdAt|date("d/m/Y") }}</p>
        <a class="btn btn-space mt-3" href="{{ path('app_account_edit') }}">{{ 'accountShow.EditAccount'|trans }}</a>
    </div>

    <h2 class="section-title">{{ 'accountShow.myVideos'|trans }}</h2>
    <div class="video-grid">
        {% for video in app.user.videos %}
            <div class="video-card">
                <a href="{{ path('app_video_show', {id: video.id}) }}">
                    <h5>{{ video.title|slice(0, 20) }}</h5>
                    <iframe width="300" height="200" src="{{ video.videoLink }}"></iframe>
                </a>
                <p>{{ video.descritpion|slice(0, 25) }}</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}