{% extends 'base.html.twig' %}

{% block title %}{{ 'videoEditTemplate.title' | trans }}{% endblock %}

{% block body %}
    <h1>{{ 'videoEditTemplate.title' | trans }} : {{ video.title }}</h1>

    {{ form_start(monForm) }}
        {{ form_row(monForm.title) }}
        {{ form_row(monForm.videoLink) }}
        {{ form_row(monForm.descritpion) }}
        {{ form_row(monForm.save) }}
    {{ form_end(monForm) }}

    <a href="{{ path('app_video_show', {id: video.id}) }}">{{ 'videoTemplate.back' | trans }}</a>
{% endblock %}