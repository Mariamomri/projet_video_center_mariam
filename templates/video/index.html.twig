{% extends 'base.html.twig' %}

{% block title %}Bienvenue dans Vidéo Center{% endblock %}

{% block body %}
    <h1>Bienvenue dans Vidéo Center</h1>

    {% for video in videos %}
        <div>
            <a href="{{ path('app_video_show', {id: video.id}) }}">
                <h3>{{ video.title|slice(0, 20) }}</h3>
                <iframe width="300" height="200" src="{{ video.videoLink }}"></iframe>
            </a>
            <p>{{ video.descritpion|slice(0, 25) }}</p>
            <p>{{ video.createdAt|ago }}</p>
        </div>
    {% endfor %}
{% endblock %}