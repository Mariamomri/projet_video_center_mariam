{% extends 'base.html.twig' %}

{% block title %}{{ 'videoCreateTemplate.title' | trans }}{% endblock %}

{% block body %}
    <div class="form-card-wrapper">
            <div class="form-card">
                <h1>{{ 'videoCreateTemplate.title' | trans }}</h1>

    {{ form_start(monForm) }}
        {{ form_row(monForm.title) }}
        {{ form_row(monForm.videoLink) }}
        {{ form_row(monForm.descritpion) }}
        {{ form_row(monForm.premiumVideo) }}
        {{ form_row(monForm.save) }}
    {{ form_end(monForm) }}

            <div class="form-links">
                <a href="{{ path('app_home') }}">{{ 'videoTemplate.back' | trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}