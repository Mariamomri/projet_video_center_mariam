{% extends 'base.html.twig' %}

{% block title %}{{ video.title }}{% endblock %}

{% block body %}
    <h1>{{ video.title }}</h1>

    <iframe width="640" height="480" src="{{ video.videoLink }}"></iframe>

    <p>{{ video.descritpion }}</p>

    <p>Publié le {{ video.createdAt|date('d/m/Y H:i') }}</p>

    <a href="{{ path('app_video_edit', {id: video.id}) }}">Éditer</a>
    <a href="{{ path('app_video_delete', {id: video.id}) }}">Supprimer</a>
    <a href="{{ path('app_home') }}">Retour</a>
{% endblock %}