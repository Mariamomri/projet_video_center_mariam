{% extends 'base.html.twig' %}

{% block title %}{{ video.title }}{% endblock %}

{% block body %}
    <h1>{{ video.title }}</h1>

    <iframe width="640" height="480" src="{{ video.videoLink }}"></iframe>

    <p>{{ video.descritpion }}</p>

    <p>{{ 'videoTemplate.publishedOn' | trans }} {{ video.createdAt|date('d/m/Y H:i') }} {{ 'videoTemplate.by' | trans }} {{ video.user.firstname }} {{ video.user.lastname }}</p>

    <a href="{{ path('app_video_edit', {id: video.id}) }}">{{ 'videoTemplate.edit' | trans }}</a>
    <a href="{{ path('app_video_delete', {id: video.id}) }}">{{ 'videoTemplate.delete' | trans }}</a>
    <a href="{{ path('app_home') }}">{{ 'videoTemplate.back' | trans }}</a>
{% endblock %}